# ── Server ───────────────────────────────────────────
PORT=3000
# Public URL where this server is reachable (used for Apple Shortcuts webhook)
PUBLIC_URL=http://localhost:3000

# ── Slack ────────────────────────────────────────────
# 1. Create a Slack app at https://api.slack.com/apps
# 2. Add these User Token Scopes:
#    stars:read, search:read, channels:history, channels:read,
#    groups:history, groups:read, im:history, im:read, users:read
# 3. Install to workspace & copy the User OAuth Token (xoxp-...)
SLACK_USER_TOKEN=
# Comma-separated channel names to watch (optional — leave blank to skip)
SLACK_WATCH_CHANNELS=
# Sync interval in minutes (default: 5)
SLACK_SYNC_INTERVAL=5

# ── Granola ──────────────────────────────────────────
# Option A: Provide tokens directly
GRANOLA_ACCESS_TOKEN=
GRANOLA_REFRESH_TOKEN=
# Option B: If running on the same Mac as Granola, auto-detect from:
#   ~/Library/Application Support/Granola/supabase.json
GRANOLA_AUTO_DETECT=true
# Sync interval in minutes (default: 10)
GRANOLA_SYNC_INTERVAL=10

# ── Apple Notes (via Shortcuts webhook) ──────────────
# A random secret key to authenticate webhook calls from Apple Shortcuts
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APPLE_NOTES_WEBHOOK_SECRET=
